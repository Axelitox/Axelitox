# URL publique du site (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.clichy-natation.com

# Parcours d'inscription et espace adhérent (Swim Community).
# À renseigner avec les URLs exactes utilisées aujourd'hui par le club.
NEXT_PUBLIC_REGISTRATION_URL=
NEXT_PUBLIC_MEMBER_AREA_URL=

# Boutique officielle (prestataire sports-village.com) — URL exacte de la boutique du club
